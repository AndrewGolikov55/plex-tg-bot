# === REQUIRED ===
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=000000000:REPLACE-WITH-YOUR-BOT-TOKEN

# Telegram chat id where approval cards land. Negative for groups.
# Send any message to @userinfobot in the same chat to find it.
ADMIN_CHAT_ID=-1001234567890

# Plex X-Plex-Token of the server-owning account.
# https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=REPLACE-WITH-YOUR-PLEX-TOKEN

# === PLEX SHARING POLICY (optional) ===
# When unset, every library is shared. Comma-separated section ids to scope.
# SHARED_LIBRARY_IDS=1,3,5

# Plex sharing flags: "1" enables, "0" disables. Defaults below.
# ALLOW_SYNC=1
# ALLOW_CAMERA_UPLOAD=0
# ALLOW_CHANNELS=0

# Override server identity (skips plex.tv resource discovery).
# PLEX_SERVER_NAME=My Plex
# PLEX_MACHINE_IDENTIFIER=abc123...

# === OVERSEERR (optional pair) ===
# When unset, the Overseerr menu button is hidden.
# OVERSEERR_PUBLIC_URL=https://overseerr.example.com
# OVERSEERR_API_KEY=

# === UX (optional) ===
# WATCH_URL=https://app.plex.tv/desktop/
# BOT_LANG=en             # supported: en, ru

# === STORAGE / NETWORK / OPS (optional) ===
# DB_PATH=/data/db.sqlite
# PROXY_URL=socks5://192.168.0.1:1080   # used for Telegram API + Plex API
# NO_PROXY=localhost,127.0.0.1
# HEALTH_PORT=9095        # /healthz + /metrics
# LOG_LEVEL=INFO
# DAILY_SYNC_CRON=0 4 * * *

# === DEPLOY (optional) ===
# Parent directory on the host. The compose manifest appends "/data"
# automatically, so set the stack root here. Example for Unraid:
#   PLEX_BOT_DATA_BIND=/mnt/user/VmBOX/docker/plex-bot
# Default (".") makes the container mount "./data" next to the compose file.
# PLEX_BOT_DATA_BIND=.

# Image tag override (use a release like v0.1.0 for stability).
# PLEX_BOT_TAG=latest

# Container name override.
# PLEX_BOT_CONTAINER_NAME=plex-tg-bot
