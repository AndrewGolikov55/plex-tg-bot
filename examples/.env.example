# plex-tg-bot environment configuration
# Copy this file to .env alongside your docker-compose.yml and fill in real values.
# Lines starting with # are comments and are ignored.

# -------------------------------------------------------------------
# REQUIRED
# -------------------------------------------------------------------

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAAA-EXAMPLE-DO-NOT-USE

# Chat id of the private group (or DM) where approval cards are sent.
# Groups have negative ids (e.g. -1001234567890). Get it via @userinfobot.
ADMIN_CHAT_ID=-1001234567890

# Plex server owner's X-Plex-Token.
# See: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=EXAMPLE_PLEX_TOKEN_DO_NOT_USE

# -------------------------------------------------------------------
# PLEX — optional overrides (auto-discovered when unset)
# -------------------------------------------------------------------

# Human-readable name of your Plex Media Server (as shown in the web UI).
# PLEX_SERVER_NAME=My Plex Server

# Machine identifier UUID of your Plex server.
# PLEX_MACHINE_IDENTIFIER=

# -------------------------------------------------------------------
# OVERSEERR — optional; both must be set together
# -------------------------------------------------------------------

# Public URL of your Overseerr instance (no trailing slash).
# When unset, the "Request content" button is hidden.
# OVERSEERR_PUBLIC_URL=https://overseerr.example.com

# Overseerr API key (Settings → General → API Key).
# Required when OVERSEERR_PUBLIC_URL is set.
# OVERSEERR_API_KEY=EXAMPLE_OVERSEERR_API_KEY

# -------------------------------------------------------------------
# UX
# -------------------------------------------------------------------

# URL opened when the user taps "Watch in browser".
# WATCH_URL=https://app.plex.tv/desktop/

# Path inside the container to the apps markdown file.
# Mount your custom file at this path via a Docker volume.
# APPS_MARKDOWN_PATH=/data/apps.md

# -------------------------------------------------------------------
# STORAGE
# -------------------------------------------------------------------

# Path inside the container to the SQLite database file.
# DB_PATH=/data/db.sqlite

# -------------------------------------------------------------------
# LOCALE
# -------------------------------------------------------------------

# Bot language. Supported: en, ru
# BOT_LANG=en

# -------------------------------------------------------------------
# NETWORKING / PROXY
# -------------------------------------------------------------------

# HTTP or SOCKS5 proxy URL for outbound Telegram and Plex API traffic.
# Use this if Telegram is blocked in your region.
# Examples:
#   PROXY_URL=socks5://192.168.0.1:1080
#   PROXY_URL=http://proxy.example.com:7890
# PROXY_URL=

# Comma-separated list of hosts that bypass the proxy.
# NO_PROXY=localhost,127.0.0.1

# -------------------------------------------------------------------
# HTTP SERVER (healthz + metrics)
# -------------------------------------------------------------------

# Port for /healthz and Prometheus /metrics endpoints.
# HEALTH_PORT=9095

# -------------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------------

# Python logging level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# -------------------------------------------------------------------
# SCHEDULER
# -------------------------------------------------------------------

# Crontab expression for the daily Plex reconciliation job.
# DAILY_SYNC_CRON=0 4 * * *

# -------------------------------------------------------------------
# PLEX SHARE POLICY
# -------------------------------------------------------------------

# Comma-separated Plex section IDs to share (empty = all libraries).
# Example: SHARED_LIBRARY_IDS=1,2,5
# SHARED_LIBRARY_IDS=

# Plex sharing flags (0 or 1).
# ALLOW_SYNC=1
# ALLOW_CAMERA_UPLOAD=0
# ALLOW_CHANNELS=0
